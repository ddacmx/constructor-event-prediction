{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed-result.v2",
  "$defs": {
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "classMetric": {"type": "object", "additionalProperties": false, "required": ["precision", "recall", "f1", "support"], "properties": {"precision": {"$ref": "#/$defs/score"}, "recall": {"$ref": "#/$defs/score"}, "f1": {"$ref": "#/$defs/score"}, "support": {"type": "integer", "minimum": 0}}},
    "perClass": {"type": "object", "additionalProperties": false, "required": ["api_interface_modified", "dependency_upgraded", "compatibility_checked", "ci_failed", "bug_fixed", "integration_test_passed", "review_approved", "deployed", "rolled_back"], "properties": {"api_interface_modified": {"$ref": "#/$defs/classMetric"}, "dependency_upgraded": {"$ref": "#/$defs/classMetric"}, "compatibility_checked": {"$ref": "#/$defs/classMetric"}, "ci_failed": {"$ref": "#/$defs/classMetric"}, "bug_fixed": {"$ref": "#/$defs/classMetric"}, "integration_test_passed": {"$ref": "#/$defs/classMetric"}, "review_approved": {"$ref": "#/$defs/classMetric"}, "deployed": {"$ref": "#/$defs/classMetric"}, "rolled_back": {"$ref": "#/$defs/classMetric"}}},
    "matrixRow": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "integer", "minimum": 0}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["accuracy", "macro_f1", "class_order", "confusion_matrix", "per_class"], "properties": {"accuracy": {"$ref": "#/$defs/score"}, "macro_f1": {"$ref": "#/$defs/score"}, "class_order": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "confusion_matrix": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/matrixRow"}}, "per_class": {"$ref": "#/$defs/perClass"}}},
    "interval": {"type": "object", "additionalProperties": false, "required": ["lower", "upper"], "properties": {"lower": {"type": "number", "minimum": -1, "maximum": 1}, "upper": {"type": "number", "minimum": -1, "maximum": 1}}},
    "intervals": {"type": "object", "additionalProperties": false, "required": ["global_frequency.accuracy", "global_frequency.macro_f1", "markov.accuracy", "markov.macro_f1", "logistic_regression.accuracy", "logistic_regression.macro_f1", "logistic_minus_global_frequency.accuracy", "logistic_minus_global_frequency.macro_f1", "logistic_minus_markov.accuracy", "logistic_minus_markov.macro_f1"], "properties": {"global_frequency.accuracy": {"$ref": "#/$defs/interval"}, "global_frequency.macro_f1": {"$ref": "#/$defs/interval"}, "markov.accuracy": {"$ref": "#/$defs/interval"}, "markov.macro_f1": {"$ref": "#/$defs/interval"}, "logistic_regression.accuracy": {"$ref": "#/$defs/interval"}, "logistic_regression.macro_f1": {"$ref": "#/$defs/interval"}, "logistic_minus_global_frequency.accuracy": {"$ref": "#/$defs/interval"}, "logistic_minus_global_frequency.macro_f1": {"$ref": "#/$defs/interval"}, "logistic_minus_markov.accuracy": {"$ref": "#/$defs/interval"}, "logistic_minus_markov.macro_f1": {"$ref": "#/$defs/interval"}}},
    "errorExample": {"type": "object", "additionalProperties": false, "required": ["confidence_margin", "example_key", "predicted", "prefix", "prefix_length_band", "target"], "properties": {"confidence_margin": {"type": "number", "minimum": 0, "maximum": 1}, "example_key": {"type": "string", "minLength": 1}, "predicted": {"type": "string", "minLength": 1}, "prefix": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "prefix_length_band": {"enum": ["short", "medium", "long"]}, "target": {"type": "string", "minLength": 1}}},
    "semanticGroup": {"type": "object", "additionalProperties": false, "required": ["count", "examples"], "properties": {"count": {"type": "integer", "minimum": 0}, "examples": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/errorExample"}}}},
    "countSection": {"type": "object", "additionalProperties": false, "required": ["count", "examples", "groups"], "properties": {"count": {"type": "integer", "minimum": 0}, "examples": {"type": "array", "maxItems": 0}, "groups": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}}}},
    "errorAnalysis": {"type": "object", "additionalProperties": false, "required": ["semantic_categories", "true_predicted_pairs", "prefix_length_bands"], "properties": {"semantic_categories": {"type": "object", "additionalProperties": false, "required": ["count", "examples", "groups"], "properties": {"count": {"type": "integer", "minimum": 0}, "examples": {"type": "array", "maxItems": 0}, "groups": {"type": "object", "additionalProperties": false, "required": ["rare_target", "post_failure_recovery", "readiness_ambiguity", "deployment_rollback_ambiguity", "other"], "properties": {"rare_target": {"$ref": "#/$defs/semanticGroup"}, "post_failure_recovery": {"$ref": "#/$defs/semanticGroup"}, "readiness_ambiguity": {"$ref": "#/$defs/semanticGroup"}, "deployment_rollback_ambiguity": {"$ref": "#/$defs/semanticGroup"}, "other": {"$ref": "#/$defs/semanticGroup"}}}}}, "true_predicted_pairs": {"$ref": "#/$defs/countSection"}, "prefix_length_bands": {"$ref": "#/$defs/countSection"}}}
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "seed", "dataset_sequence_count", "split_manifest", "split_manifest_sha256", "test_example_count", "test_example_keys_sha256", "test_example_keys_definition", "test_sequence_lengths", "split", "model", "evaluation"],
  "properties": {
    "schema_version": {"const": "benchmark-seed-result.v2"}, "seed": {"type": "integer"}, "dataset_sequence_count": {"type": "integer", "minimum": 1},
    "split_manifest": {"type": "string", "minLength": 1}, "split_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test_example_count": {"type": "integer", "minimum": 1}, "test_example_keys_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "test_example_keys_definition": {"type": "string", "minLength": 1},
    "test_sequence_lengths": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 2}},
    "split": {"type": "object", "additionalProperties": false, "required": ["train_sequences", "validation_sequences", "test_sequences"], "properties": {"train_sequences": {"type": "integer", "minimum": 1}, "validation_sequences": {"type": "integer", "minimum": 1}, "test_sequences": {"type": "integer", "minimum": 1}}},
    "baseline_state": {"type": "object", "additionalProperties": false, "required": ["manifest", "schema_version", "arrays", "arrays_sha256", "event_vocabulary", "alpha", "provenance"], "properties": {"manifest": {"type": "string", "minLength": 1}, "schema_version": {"const": "baseline-state.v1"}, "arrays": {"type": "string", "minLength": 1}, "arrays_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "event_vocabulary": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "alpha": {"type": "number", "minimum": 0.000000000000001}, "provenance": {"type": "object", "additionalProperties": false, "required": ["config_hash", "split_seed", "training_examples_hash", "final_profile_hash", "training_protocol"], "properties": {"config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "split_seed": {"type": "integer"}, "training_examples_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "final_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "training_protocol": {"const": "observable-prefix-baselines.v1"}}}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["manifest", "schema_version", "arrays", "arrays_sha256", "classes", "event_catalog", "feature_count", "feature_names", "model_seed", "python_version", "scikit_learn_version", "selected_c", "selection_report", "provenance", "recency_cap"], "properties": {"manifest": {"type": "string", "minLength": 1}, "schema_version": {"const": "event-predictor.v2"}, "arrays": {"type": "string", "minLength": 1}, "arrays_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "classes": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "event_catalog": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "feature_count": {"type": "integer", "minimum": 1}, "feature_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "model_seed": {"type": "integer"}, "python_version": {"type": "string", "minLength": 1}, "scikit_learn_version": {"type": "string", "minLength": 1}, "selected_c": {"type": "number", "minimum": 0.000000000000001}, "selection_report": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["c", "converged", "validation_macro_f1"], "properties": {"c": {"type": "number", "minimum": 0.000000000000001}, "converged": {"type": "boolean"}, "validation_macro_f1": {"$ref": "#/$defs/score"}}}}, "provenance": {"type": "object", "additionalProperties": false, "required": ["config_hash", "split_seed", "training_examples_hash", "final_profile_hash"], "properties": {"config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "split_seed": {"type": "integer"}, "training_examples_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "final_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, "recency_cap": {"type": "integer", "minimum": 1}}},
    "prediction_evidence": {"type": "string", "minLength": 1},
    "prediction_evidence_schema": {"const": "keyed-predictions.v1"},
    "prediction_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluation": {"type": "object", "additionalProperties": false, "required": ["example_count", "metrics", "bootstrap", "error_analysis"], "properties": {"example_count": {"type": "integer", "minimum": 1}, "metrics": {"type": "object", "additionalProperties": false, "required": ["global_frequency", "markov", "logistic_regression"], "properties": {"global_frequency": {"$ref": "#/$defs/metric"}, "markov": {"$ref": "#/$defs/metric"}, "logistic_regression": {"$ref": "#/$defs/metric"}}}, "bootstrap": {"type": "object", "additionalProperties": false, "required": ["cluster_count", "replicates", "seed", "intervals_95"], "properties": {"cluster_count": {"type": "integer", "minimum": 2}, "replicates": {"type": "integer", "minimum": 20}, "seed": {"type": "integer"}, "intervals_95": {"$ref": "#/$defs/intervals"}}}, "error_analysis": {"$ref": "#/$defs/errorAnalysis"}}}
  }
}
