{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-manifest.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "arrays", "arrays_sha256", "classes", "event_catalog", "feature_count", "feature_names", "model_seed", "python_version", "scikit_learn_version", "selected_c", "selection_report", "provenance", "recency_cap"],
  "properties": {
    "schema_version": {"const": "event-predictor.v2"},
    "arrays": {"type": "string", "minLength": 1},
    "arrays_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classes": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "event_catalog": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "feature_count": {"type": "integer", "minimum": 1},
    "feature_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "model_seed": {"type": "integer"},
    "python_version": {"type": "string", "minLength": 1},
    "scikit_learn_version": {"type": "string", "minLength": 1},
    "selected_c": {"type": "number", "minimum": 0.000000000000001},
    "selection_report": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["c", "converged", "validation_macro_f1"], "properties": {"c": {"type": "number", "minimum": 0.000000000000001}, "converged": {"type": "boolean"}, "validation_macro_f1": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["config_hash", "split_seed", "training_examples_hash", "final_profile_hash"], "properties": {"config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "split_seed": {"type": "integer"}, "training_examples_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "final_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "recency_cap": {"type": "integer", "minimum": 1}
  }
}
