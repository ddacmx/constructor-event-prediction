{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aggregate-result.v2",
  "$defs": {
    "scoreSummary": {"type": "object", "additionalProperties": false, "required": ["mean", "sample_stddev", "values"], "properties": {"mean": {"type": "number", "minimum": 0, "maximum": 1}, "sample_stddev": {"type": ["number", "null"], "minimum": 0}, "values": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "matrixRow": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "integer", "minimum": 0}},
    "support": {"type": "object", "additionalProperties": false, "required": ["api_interface_modified", "dependency_upgraded", "compatibility_checked", "ci_failed", "bug_fixed", "integration_test_passed", "review_approved", "deployed", "rolled_back"], "properties": {"api_interface_modified": {"type": "integer", "minimum": 0}, "dependency_upgraded": {"type": "integer", "minimum": 0}, "compatibility_checked": {"type": "integer", "minimum": 0}, "ci_failed": {"type": "integer", "minimum": 0}, "bug_fixed": {"type": "integer", "minimum": 0}, "integration_test_passed": {"type": "integer", "minimum": 0}, "review_approved": {"type": "integer", "minimum": 0}, "deployed": {"type": "integer", "minimum": 0}, "rolled_back": {"type": "integer", "minimum": 0}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["accuracy", "macro_f1", "summed_confusion_matrix", "summed_class_support"], "properties": {"accuracy": {"$ref": "#/$defs/scoreSummary"}, "macro_f1": {"$ref": "#/$defs/scoreSummary"}, "summed_confusion_matrix": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/matrixRow"}}, "summed_class_support": {"$ref": "#/$defs/support"}}},
    "interval": {"type": "object", "additionalProperties": false, "required": ["lower", "upper"], "properties": {"lower": {"type": "number", "minimum": -1, "maximum": 1}, "upper": {"type": "number", "minimum": -1, "maximum": 1}}},
    "intervals": {"type": "object", "additionalProperties": false, "required": ["global_frequency.accuracy", "global_frequency.macro_f1", "markov.accuracy", "markov.macro_f1", "logistic_regression.accuracy", "logistic_regression.macro_f1", "logistic_minus_global_frequency.accuracy", "logistic_minus_global_frequency.macro_f1", "logistic_minus_markov.accuracy", "logistic_minus_markov.macro_f1"], "properties": {"global_frequency.accuracy": {"$ref": "#/$defs/interval"}, "global_frequency.macro_f1": {"$ref": "#/$defs/interval"}, "markov.accuracy": {"$ref": "#/$defs/interval"}, "markov.macro_f1": {"$ref": "#/$defs/interval"}, "logistic_regression.accuracy": {"$ref": "#/$defs/interval"}, "logistic_regression.macro_f1": {"$ref": "#/$defs/interval"}, "logistic_minus_global_frequency.accuracy": {"$ref": "#/$defs/interval"}, "logistic_minus_global_frequency.macro_f1": {"$ref": "#/$defs/interval"}, "logistic_minus_markov.accuracy": {"$ref": "#/$defs/interval"}, "logistic_minus_markov.macro_f1": {"$ref": "#/$defs/interval"}}},
    "paired": {"type": "object", "additionalProperties": false, "required": ["mean", "sample_stddev", "values", "sequence_clustered_intervals_by_seed"], "properties": {"mean": {"type": "number", "minimum": -1, "maximum": 1}, "sample_stddev": {"type": ["number", "null"], "minimum": 0}, "values": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": -1, "maximum": 1}}, "sequence_clustered_intervals_by_seed": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interval"}}}},
    "errorSection": {"type": "object", "additionalProperties": false, "required": ["count", "examples", "groups"], "properties": {"count": {"type": "integer", "minimum": 0}, "examples": {"type": "array", "maxItems": 0}, "groups": {"type": "object", "minProperties": 1}}},
    "errorAnalysis": {"type": "object", "additionalProperties": false, "required": ["semantic_categories", "true_predicted_pairs", "prefix_length_bands"], "properties": {"semantic_categories": {"$ref": "#/$defs/errorSection"}, "true_predicted_pairs": {"$ref": "#/$defs/errorSection"}, "prefix_length_bands": {"$ref": "#/$defs/errorSection"}}}
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "confusion_matrix_order", "seed_count", "models", "paired_comparisons", "sequence_clustered_intervals_by_seed", "error_analysis_by_seed", "interpretation"],
  "properties": {
    "schema_version": {"const": "benchmark-aggregate.v2"},
    "confusion_matrix_order": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "seed_count": {"type": "integer", "minimum": 1},
    "models": {"type": "object", "additionalProperties": false, "required": ["global_frequency", "markov", "logistic_regression"], "properties": {"global_frequency": {"$ref": "#/$defs/model"}, "markov": {"$ref": "#/$defs/model"}, "logistic_regression": {"$ref": "#/$defs/model"}}},
    "paired_comparisons": {"type": "object", "additionalProperties": false, "required": ["logistic_minus_markov.accuracy", "logistic_minus_markov.macro_f1", "logistic_minus_global_frequency.accuracy", "logistic_minus_global_frequency.macro_f1"], "properties": {"logistic_minus_markov.accuracy": {"$ref": "#/$defs/paired"}, "logistic_minus_markov.macro_f1": {"$ref": "#/$defs/paired"}, "logistic_minus_global_frequency.accuracy": {"$ref": "#/$defs/paired"}, "logistic_minus_global_frequency.macro_f1": {"$ref": "#/$defs/paired"}}},
    "sequence_clustered_intervals_by_seed": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/intervals"}},
    "error_analysis_by_seed": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/errorAnalysis"}},
    "interpretation": {"type": "string", "minLength": 1}
  }
}
